<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Syncfusion.DotNet.Cli.Maui</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Syncfusion.DotNet.Cli.Core\Syncfusion.DotNet.Cli.Core.csproj" />
  </ItemGroup>

  <!--
    The Templates folder holds placeholder text (XAML/C# with __PLACEHOLDER__
    tokens), not real source. Exclude it from compilation so
    the SDK does not try to build the placeholder .cs files.
  -->
  <ItemGroup>
    <Compile Remove="Templates\**" />
    <None Remove="Templates\**" />
    <MauiXaml Remove="Templates\**" />
  </ItemGroup>

  <!--
    Embed the independent package and control-template catalogs, template resources,
    dictionaries so they ship inside the packaged .NET tool. Files are embedded
    with logical names that mirror their on-disk paths so the embedded-resource
    loader can find them by name. Each catalog has a dedicated logical name.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Catalog\package-catalog.json">
      <LogicalName>Syncfusion.DotNet.Cli.Maui.Catalog.package-catalog.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Catalog\template-catalog.json">
      <LogicalName>Syncfusion.DotNet.Cli.Maui.Catalog.template-catalog.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    Embed every control template file with a logical name matching the catalog
    path (folder separators become dots), e.g.
    Syncfusion.DotNet.Cli.Maui.Templates.Controls.DataGrid.DataGridView.xaml
    which matches what TemplatePathResolver.ResolveResourceName builds.
    Finder metadata and AppleDouble/archive sidecars are not templates and
    must not enter the assembly, even when they are present in a local checkout.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Templates\**\*.*" Exclude="Templates\Welcome\**;Templates\**\.DS_Store;Templates\**\._*;Templates\**\__MACOSX\**">
      <LogicalName>Syncfusion.DotNet.Cli.Maui.Templates.Controls.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Templates\Welcome\**\*.*" Exclude="Templates\Welcome\**\.DS_Store;Templates\Welcome\**\._*;Templates\Welcome\**\__MACOSX\**" />
  </ItemGroup>

</Project>
