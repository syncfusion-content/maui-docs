<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.DataGrid;assembly=Syncfusion.Maui.DataGrid"
             xmlns:local="clr-namespace:__ROOT_NAMESPACE__.__CONTROL_NAME__"
             Title="DataGrid"
             x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.__VIEW_NAME__"
             x:DataType="local:__VIEW_MODEL_NAME__">
    <ContentPage.BindingContext>
        <local:__VIEW_MODEL_NAME__ />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <syncfusion:SfDataGrid ItemsSource="{Binding Orders}"
                               AutoGenerateColumnsMode="None"
                               ColumnWidthMode="Fill"
                               HorizontalOptions="Fill"
                               VerticalOptions="Fill">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:DataGridTextColumn MappingName="OrderID" HeaderText="Order ID" MinimumWidth="100" />
                <syncfusion:DataGridTextColumn MappingName="CustomerID" HeaderText="Customer ID" MinimumWidth="110" />
                <syncfusion:DataGridTextColumn MappingName="Customer" HeaderText="Customer" MinimumWidth="150" />
                <syncfusion:DataGridTextColumn MappingName="ShipCity" HeaderText="Ship city" MinimumWidth="130" />
                <syncfusion:DataGridTextColumn MappingName="ShipCountry" HeaderText="Ship country" MinimumWidth="130" />
                <syncfusion:DataGridDateColumn MappingName="OrderDate" HeaderText="Order date" Format="d" MinimumWidth="120" />
                <syncfusion:DataGridTextColumn MappingName="Product" HeaderText="Product" MinimumWidth="150" />
                <syncfusion:DataGridNumericColumn MappingName="Quantity" HeaderText="Quantity" Format="N0" MinimumWidth="100" />
                <syncfusion:DataGridNumericColumn MappingName="UnitPrice" HeaderText="Unit price" Format="C2" MinimumWidth="120" />
                <syncfusion:DataGridNumericColumn MappingName="Total" HeaderText="Total" Format="C2" MinimumWidth="120" AllowEditing="False" />
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</ContentPage>
