<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncfusion="clr-namespace:Syncfusion.Maui.Kanban;assembly=Syncfusion.Maui.Kanban"
             xmlns:local="clr-namespace:__ROOT_NAMESPACE__.__CONTROL_NAME__"
             Title="Kanban"
             x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.__VIEW_NAME__"
             x:DataType="local:__VIEW_MODEL_NAME__">
    <ContentPage.BindingContext>
        <local:__VIEW_MODEL_NAME__ />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <syncfusion:SfKanban x:Name="kanban"
                             AutoGenerateColumns="False"
                             ItemsSource="{Binding Cards}"
                             HorizontalOptions="Fill"
                             VerticalOptions="Fill">
            <syncfusion:KanbanColumn Title="To Do"
                                     Categories="Open,Postponed" />
            <syncfusion:KanbanColumn Title="In Progress"
                                     Categories="In Progress" />
            <syncfusion:KanbanColumn Title="Code Review"
                                     Categories="Code Review" />
            <syncfusion:KanbanColumn Title="Done"
                                     Categories="Closed,Closed No Changes,Won't Fix" />
        </syncfusion:SfKanban>
    </Grid>
</ContentPage>
