<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:welcome="clr-namespace:__ROOT_NAMESPACE__.Welcome"
    x:Class="__ROOT_NAMESPACE__.Welcome.WelcomeView"
    x:DataType="welcome:WelcomeViewModel"
    Title="Welcome" Shell.NavBarIsVisible="False"
    SafeAreaEdges="All"
    MinimumWidthRequest="0" MinimumHeightRequest="0">
    <ContentPage.Resources>
        <Style x:Key="Heading" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="FontSize" Value="22" />
        </Style>
        <Style x:Key="Body" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>
        <Style x:Key="Link" TargetType="Button">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="TextTransform" Value="None" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Focused">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="None" />
            <Setter Property="Padding" Value="0,10" />
            <Setter Property="MinimumHeightRequest" Value="44" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
            <Setter Property="HorizontalOptions" Value="Start" />
        </Style>
    </ContentPage.Resources>
    <ScrollView x:Name="WelcomeScroll" Orientation="Vertical" MinimumWidthRequest="0" MinimumHeightRequest="0">
        <Grid x:Name="WelcomeContent" RowDefinitions="*,Auto" RowSpacing="32" Padding="24,40,24,24"
            MaximumWidthRequest="1208" HorizontalOptions="Center" MinimumWidthRequest="0" MinimumHeightRequest="0">
            <VerticalStackLayout Spacing="32" MinimumWidthRequest="0" MinimumHeightRequest="0">
                <VerticalStackLayout Spacing="12" MinimumWidthRequest="0" MinimumHeightRequest="0">
                    <Label Text="Welcome to Your New .NET MAUI App" FontSize="36" FontAttributes="Bold"
                        LineBreakMode="WordWrap" SemanticProperties.HeadingLevel="Level1"
                        TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                    <Label Text="Your application is running successfully." Style="{StaticResource Body}" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                </VerticalStackLayout>
                <Border Padding="24" StrokeShape="RoundRectangle 16"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" MinimumWidthRequest="0" MinimumHeightRequest="0">
                    <VerticalStackLayout Spacing="16" MinimumWidthRequest="0" MinimumHeightRequest="0">
                        <Label Text="Your control samples" Style="{StaticResource Heading}"
                            SemanticProperties.HeadingLevel="Level2" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                        <Label Text="Select a control to explore its sample." Style="{StaticResource Body}"
                            IsVisible="{Binding HasSamples}" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                        <Label Text="You’re all set! Add a Syncfusion control with the sfdotnet CLI to see its sample here."
                            Style="{StaticResource Body}" IsVisible="{Binding IsEmpty}" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                        <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start"
                            BindableLayout.ItemsSource="{Binding Samples}" IsVisible="{Binding HasSamples}" MinimumWidthRequest="0" MinimumHeightRequest="0">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="welcome:ControlSample">
                                    <Button Text="{Binding Name}" CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type welcome:WelcomeViewModel}}, Path=OpenSampleCommand}"
                                        TextTransform="None" LineBreakMode="WordWrap" CornerRadius="22"
                                        Margin="0,0,8,8" Padding="18,12" MinimumHeightRequest="48"
                                        FontSize="16" FlexLayout.Shrink="1"
                                        SemanticProperties.Hint="Opens this control’s sample page" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
                <VerticalStackLayout Spacing="16" MinimumWidthRequest="0" MinimumHeightRequest="0">
                    <Label Text="Build something great" Style="{StaticResource Heading}"
                        SemanticProperties.HeadingLevel="Level2" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                    <welcome:WelcomeResourceGrid ColumnSpacing="16" RowSpacing="16"
                        BindableLayout.ItemsSource="{Binding Resources}" MinimumWidthRequest="0" MinimumHeightRequest="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="welcome:WelcomeModel">
                                <Border Padding="20" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}" MinimumWidthRequest="0" MinimumHeightRequest="0">
                                    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" MinimumWidthRequest="0" MinimumHeightRequest="0">
                                        <Image Source="{Binding Icon}" WidthRequest="32" HeightRequest="32"
                                            HorizontalOptions="Start" SemanticProperties.Description="" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                                        <Label Grid.Row="1" Text="{Binding Title}" FontSize="18"
                                            Style="{StaticResource Heading}" SemanticProperties.HeadingLevel="Level3" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                                        <Label Grid.Row="2" Text="{Binding Description}" Style="{StaticResource Body}" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                                        <Button Grid.Row="3" Text="{Binding Action}" Style="{StaticResource Link}"
                                            CommandParameter="{Binding Url}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type welcome:WelcomeViewModel}}, Path=OpenLinkCommand}"
                                            SemanticProperties.Hint="Opens this resource in your browser" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </welcome:WelcomeResourceGrid>
                </VerticalStackLayout>
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Body}" MinimumWidthRequest="0" MinimumHeightRequest="0" />
            </VerticalStackLayout>
            <Grid x:Name="Footer" Grid.Row="1" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12" ColumnSpacing="24" MinimumWidthRequest="0" MinimumHeightRequest="0">
                <Label x:Name="Copyright" Text="Copyright © 2001 - 2026 Syncfusion®, Inc. All Rights Reserved"
                    Style="{StaticResource Body}" FontSize="12" VerticalOptions="Center" HorizontalTextAlignment="Start" MinimumWidthRequest="0" MinimumHeightRequest="0" />
                <Grid x:Name="FooterLinks" Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="16" RowSpacing="4"
                    HorizontalOptions="End" MinimumWidthRequest="0" MinimumHeightRequest="0">
                    <Button Text="Privacy Policy" Style="{StaticResource Link}" FontSize="12" HorizontalOptions="Fill"
                        Command="{Binding OpenLinkCommand}" CommandParameter="https://www.syncfusion.com/legal/privacy-policy/"
                        SemanticProperties.Hint="Opens Syncfusion’s privacy policy in your default browser" />
                    <Button Grid.Column="1" Text="Terms of Service" Style="{StaticResource Link}" FontSize="12" HorizontalOptions="Fill"
                        Command="{Binding OpenLinkCommand}" CommandParameter="https://www.syncfusion.com/legal/website-terms-of-use/"
                        SemanticProperties.Hint="Opens Syncfusion’s terms of use in your default browser" />
                    <Button Grid.Column="2" Text="Contact Us" Style="{StaticResource Link}" FontSize="12" HorizontalOptions="Fill"
                        Command="{Binding OpenLinkCommand}" CommandParameter="https://www.syncfusion.com/company/contact-us"
                        SemanticProperties.Hint="Opens Syncfusion’s contact page in your default browser" />
                </Grid>
            </Grid>
        </Grid>
    </ScrollView>
</ContentPage>
