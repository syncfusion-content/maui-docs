<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:scheduler="clr-namespace:Syncfusion.Maui.Scheduler;assembly=Syncfusion.Maui.Scheduler"
             xmlns:local="clr-namespace:__ROOT_NAMESPACE__.__CONTROL_NAME__"
             Title="Scheduler"
             x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.__VIEW_NAME__"
             x:DataType="local:__VIEW_MODEL_NAME__">
    <ContentPage.BindingContext>
        <local:__VIEW_MODEL_NAME__ />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <scheduler:SfScheduler HorizontalOptions="Fill" VerticalOptions="Fill" AppointmentsSource="{Binding Appointments}">
            <scheduler:SfScheduler.AppointmentMapping>
                <scheduler:SchedulerAppointmentMapping Subject="Subject"
                                                        StartTime="StartTime"
                                                        EndTime="EndTime" />
            </scheduler:SfScheduler.AppointmentMapping>
        </scheduler:SfScheduler>
    </Grid>
</ContentPage>
