<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:richTextEditor="clr-namespace:Syncfusion.Maui.RichTextEditor;assembly=Syncfusion.Maui.RichTextEditor"
             xmlns:local="clr-namespace:__ROOT_NAMESPACE__.__CONTROL_NAME__"
             Title="Rich Text Editor"
             x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.__VIEW_NAME__"
             x:DataType="local:__VIEW_MODEL_NAME__">
    <ContentPage.BindingContext>
        <local:__VIEW_MODEL_NAME__ />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <richTextEditor:SfRichTextEditor HorizontalOptions="Fill" VerticalOptions="Fill" ShowToolbar="True" Value="{Binding HtmlText, Mode=TwoWay}" />
    </Grid>
</ContentPage>
