<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:chart="clr-namespace:Syncfusion.UI.Xaml.Charts;assembly=Syncfusion.SfChart.WPF"
      xmlns:local="clr-namespace:__ROOT_NAMESPACE__.__CONTROL_NAME__"
      x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.__VIEW_NAME__">
    <Page.DataContext>
        <local:__VIEW_MODEL_NAME__ />
    </Page.DataContext>

    <Grid>
        <chart:SfChart Margin="20"
                       Header="Trade Volume Analysis: Imports and Exports"
                       FontSize="17"
                       FontWeight="Bold">
            <chart:SfChart.PrimaryAxis>
                <chart:CategoryAxis PlotOffset="20" />
            </chart:SfChart.PrimaryAxis>
            <chart:SfChart.SecondaryAxis>
                <chart:NumericalAxis />
            </chart:SfChart.SecondaryAxis>
            <chart:SfChart.Legend>
                <chart:ChartLegend Margin="11" />
            </chart:SfChart.Legend>
            <chart:SfChart.Behaviors>
                <chart:ChartSelectionBehavior EnableSegmentSelection="True" />
                <chart:ChartTrackBallBehavior />
                <chart:ChartZoomPanBehavior EnableDirectionalZooming="True"
                                            EnablePanning="True"
                                            EnableSelectionZooming="True" />
            </chart:SfChart.Behaviors>
            <chart:LineSeries ItemsSource="{Binding Data}"
                              XBindingPath="Name"
                              YBindingPath="Imports"
                              EnableAnimation="True"
                              SegmentSelectionBrush="#d1d1e0"
                              ShowTooltip="True"
                              Label="Imports">
                <chart:LineSeries.AdornmentsInfo>
                    <chart:ChartAdornmentInfo ShowLabel="True"
                                              SegmentLabelFormat="0.00'B" />
                </chart:LineSeries.AdornmentsInfo>
            </chart:LineSeries>
            <chart:LineSeries ItemsSource="{Binding Data}"
                              XBindingPath="Name"
                              YBindingPath="Exports"
                              EnableAnimation="True"
                              SegmentSelectionBrush="#d1d1e0"
                              ShowTooltip="True"
                              Label="Exports">
                <chart:LineSeries.AdornmentsInfo>
                    <chart:ChartAdornmentInfo ShowLabel="True"
                                              LabelPosition="Inner"
                                              SegmentLabelFormat="0.00'B" />
                </chart:LineSeries.AdornmentsInfo>
            </chart:LineSeries>
        </chart:SfChart>
    </Grid>
</Page>
