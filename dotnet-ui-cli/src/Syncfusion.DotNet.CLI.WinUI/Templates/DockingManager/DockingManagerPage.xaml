<Page
    x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.DockingManagerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docking="using:Syncfusion.UI.Xaml.Docking">
    <Grid Padding="16">
        <docking:SfDockingManager HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <docking:DockPane Header="Solution Explorer" DockDirection="Left" DesiredDockSize="220" DockState="Docked">
                <TreeView AutomationProperties.Name="Solution Explorer">
                    <TreeView.RootNodes>
                        <TreeViewNode Content="Sample project" IsExpanded="True">
                            <TreeViewNode.Children>
                                <TreeViewNode Content="MainWindow.xaml" />
                                <TreeViewNode Content="MainWindow.xaml.cs" />
                                <TreeViewNode Content="App.xaml" />
                            </TreeViewNode.Children>
                        </TreeViewNode>
                    </TreeView.RootNodes>
                </TreeView>
            </docking:DockPane>
            <docking:DockPane Header="Document" DockState="Document" DockDirection="Center">
                <TextBox AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         AutomationProperties.Name="Document editor"
                         Text="Drag a pane header to rearrange the workspace. Edit this document or pin and unpin the tool panes." />
            </docking:DockPane>
            <docking:DockPane Header="Properties" DockDirection="Right" DesiredDockSize="220" DockState="Docked">
                <StackPanel Padding="12" Spacing="12">
                    <TextBox Header="Document name" Text="Untitled" />
                    <TextBlock Text="Move, float or auto-hide this pane using its header." TextWrapping="Wrap" />
                </StackPanel>
            </docking:DockPane>
            <docking:DockPane Header="Output" DockDirection="Bottom" DesiredDockSize="140" DockState="Docked">
                <TextBlock Margin="12" Text="Workspace ready. Docked panes can be resized and rearranged." TextWrapping="Wrap" />
            </docking:DockPane>
        </docking:SfDockingManager>
    </Grid>
</Page>
