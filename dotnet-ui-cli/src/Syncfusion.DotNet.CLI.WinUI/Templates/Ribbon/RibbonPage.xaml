<Page
    x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.RibbonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ribbon="using:Syncfusion.UI.Xaml.Ribbon">
    <Grid RowSpacing="16" Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ribbon:SfRibbon LayoutModeOptions="Normal" AllowMinimize="True">
            <ribbon:SfRibbon.Tabs>
                <ribbon:RibbonTab Header="Home">
                    <ribbon:RibbonGroup Header="Document">
                        <ribbon:RibbonButton Content="New" Icon="Add" Tag="new" Click="OnCommand" />
                        <ribbon:RibbonButton Content="Reset sample" Icon="Refresh" Tag="reset" Click="OnCommand" />
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup Header="Clipboard">
                        <ribbon:RibbonButton Content="Cut" Icon="Cut" Tag="cut" Click="OnCommand" />
                        <ribbon:RibbonButton Content="Copy" Icon="Copy" Tag="copy" Click="OnCommand" />
                        <ribbon:RibbonButton Content="Paste" Icon="Paste" Tag="paste" Click="OnCommand" />
                    </ribbon:RibbonGroup>
                    <ribbon:RibbonGroup Header="Editing">
                        <ribbon:RibbonButton Content="Undo" Icon="Undo" Tag="undo" Click="OnCommand" />
                        <ribbon:RibbonButton Content="Select all" Icon="SelectAll" Tag="select-all" Click="OnCommand" />
                    </ribbon:RibbonGroup>
                </ribbon:RibbonTab>
            </ribbon:SfRibbon.Tabs>
        </ribbon:SfRibbon>
        <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalContentAlignment="Top" AutomationProperties.Name="Document editor"
                 PlaceholderText="Write a document, then use the ribbon to edit it." />
    </Grid>
</Page>
