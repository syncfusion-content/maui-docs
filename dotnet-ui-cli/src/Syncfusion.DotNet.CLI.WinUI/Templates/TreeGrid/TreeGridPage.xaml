<Page
    x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.TreeGridPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tree="using:Syncfusion.UI.Xaml.TreeGrid">
    <Grid Padding="16">
        <tree:SfTreeGrid ItemsSource="{Binding Employees}" AutoGenerateColumns="False"
                         ParentPropertyName="Id" ChildPropertyName="ReportsTo" SelfRelationRootValue="-1"
                         AutoExpandMode="RootNodesExpanded" ColumnWidthMode="Star"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <tree:SfTreeGrid.Columns>
                <tree:TreeGridTextColumn MappingName="Name" HeaderText="Employee" />
                <tree:TreeGridTextColumn MappingName="Title" HeaderText="Job title" />
                <tree:TreeGridTextColumn MappingName="Department" HeaderText="Department" />
                <tree:TreeGridTextColumn MappingName="Location" HeaderText="Location" />
                <tree:TreeGridNumericColumn MappingName="Id" HeaderText="Employee ID" />
            </tree:SfTreeGrid.Columns>
        </tree:SfTreeGrid>
    </Grid>
</Page>
