<Page
    x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.CircularChartPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:charts="using:Syncfusion.UI.Xaml.Charts">
    <Grid Padding="16">
        <charts:SfCircularChart Header="PRODUCT SALES">
            <charts:SfCircularChart.Legend>
                <charts:ChartLegend />
            </charts:SfCircularChart.Legend>
            <charts:SfCircularChart.Series>
                <charts:PieSeries
                    ShowDataLabels="True"
                    EnableTooltip="True"
                    ItemsSource="{Binding Data}"
                    XBindingPath="Product"
                    YBindingPath="SalesRate" />
            </charts:SfCircularChart.Series>
        </charts:SfCircularChart>
    </Grid>
</Page>