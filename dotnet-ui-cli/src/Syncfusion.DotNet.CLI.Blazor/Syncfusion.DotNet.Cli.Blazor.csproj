<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Syncfusion.DotNet.Cli.Blazor</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Syncfusion.DotNet.Cli.Core\Syncfusion.DotNet.Cli.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Syncfusion.DotNet.Cli.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Templates/**" />
    <EmbeddedResource Include="Templates/Controls/**/*.*">
      <LogicalName>$(AssemblyName).Templates.Controls.$([System.String]::Copy('%(RecursiveDir)').Replace('\', '.').Replace('/', '.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Templates/Welcome/**/*.*">
      <LogicalName>$(AssemblyName).Templates.Welcome.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Catalog/available-packages.json" />
  </ItemGroup>
</Project>
