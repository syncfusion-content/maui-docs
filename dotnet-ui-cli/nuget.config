<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Use a single public source for this repo so central package management
       does not require package source mapping (NU1507). The corporate Nexus
       and offline feeds are intentionally excluded from this repo's restore. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
