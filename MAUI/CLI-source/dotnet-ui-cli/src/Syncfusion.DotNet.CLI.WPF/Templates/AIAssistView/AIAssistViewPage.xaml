<Page
    x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.__VIEW_NAME__"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:__ROOT_NAMESPACE__.__CONTROL_NAME__"
    xmlns:aiassistview="clr-namespace:Syncfusion.UI.Xaml.Chat;assembly=Syncfusion.SfChat.WPF">

    <Page.DataContext>
        <local:__VIEW_MODEL_NAME__ />
    </Page.DataContext>

    <Grid Margin="16">
        <aiassistview:SfAIAssistView
            MaxWidth="900"
            MaxHeight="800"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            CurrentUser="{Binding CurrentUser}"
            Messages="{Binding Chats}"
            TypingIndicator="{Binding TypingIndicator}"
            ShowTypingIndicator="{Binding ShowTypingIndicator}">

            <aiassistview:SfAIAssistView.BannerTemplate>
                <DataTemplate>
                    <StackPanel
                        Margin="16"
                        HorizontalAlignment="Center">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Text="AI Assist" />

                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Text="Your best AI companion" />
                    </StackPanel>
                </DataTemplate>
            </aiassistview:SfAIAssistView.BannerTemplate>
        </aiassistview:SfAIAssistView>
    </Grid>
</Page>