<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:sfpdfviewer="clr-namespace:Syncfusion.Maui.PdfViewer;assembly=Syncfusion.Maui.PdfViewer"
             xmlns:local="clr-namespace:__ROOT_NAMESPACE__.__CONTROL_NAME__"
             x:Class="__ROOT_NAMESPACE__.__CONTROL_NAME__.__VIEW_NAME__"
             x:DataType="local:__VIEW_MODEL_NAME__"
             Title="PDF Viewer">
    <ContentPage.BindingContext>
        <local:__VIEW_MODEL_NAME__ />
    </ContentPage.BindingContext>
    <Grid RowDefinitions="*" ColumnDefinitions="*">
        <sfpdfviewer:SfPdfViewer x:Name="PdfViewer"
                                 DocumentSource="{Binding DocumentStream}"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Fill" />
        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
        <Label Text="{Binding ErrorMessage}"
               IsVisible="{Binding HasError}"
               Margin="16"
               LineBreakMode="WordWrap"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
    </Grid>
</ContentPage>
