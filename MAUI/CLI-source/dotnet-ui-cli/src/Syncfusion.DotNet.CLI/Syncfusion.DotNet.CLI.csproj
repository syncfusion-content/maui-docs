<Project Sdk="Microsoft.NET.Sdk">

<PropertyGroup>
  <TargetFramework>net10.0</TargetFramework>
  <OutputType>Exe</OutputType>
  <AssemblyName>Syncfusion.DotNet.CLI</AssemblyName>
  <RootNamespace>Syncfusion.DotNet.CLI</RootNamespace>

  <!-- .NET Tool -->
  <PackAsTool>true</PackAsTool>
  <PackageId>Syncfusion.DotNet.CLI</PackageId>
  <ToolCommandName>sf</ToolCommandName>

  <!-- NuGet Metadata -->
  <Title>Syncfusion .NET CLI</Title>
  <Company>Syncfusion® Inc.</Company>
  <Authors>Syncfusion® Inc.</Authors>
  <Copyright>Copyright 2001 - 2026 Syncfusion® Inc.</Copyright>

  <Description>
    Syncfusion .NET CLI provides commands to scaffold, configure, and manage Syncfusion applications across .NET platforms including MAUI, Blazor, WPF, WinForms, and WinUI.
  </Description>

  <PackageProjectUrl>
    https://www.syncfusion.com
  </PackageProjectUrl>

  <PackageReadmeFile>
    README.md
  </PackageReadmeFile>

  <PackageIcon>
    syncfusion_logo.png
  </PackageIcon>

  <PackageLicenseFile>
    LICENSE.txt
  </PackageLicenseFile>

  <PackageTags>
    syncfusion;cli;dotnet;tool;maui;blazor;wpf;winforms;winui
  </PackageTags>

  <!-- Existing properties -->
  <PackageOutputPath>
    $(MSBuildThisFileDirectory)..\..\artifacts\packages
  </PackageOutputPath>

  <IsPackable>true</IsPackable>
  <IsTool>true</IsTool>

  <TieredPGO>false</TieredPGO>
  <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  <PublishReadyToRun>true</PublishReadyToRun>
  <TieredCompilation>true</TieredCompilation>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Syncfusion.DotNet.CLI.Core\Syncfusion.DotNet.CLI.Core.csproj" />
    <ProjectReference Include="..\Syncfusion.DotNet.CLI.Maui\Syncfusion.DotNet.CLI.Maui.csproj" />
    <ProjectReference Include="..\Syncfusion.DotNet.CLI.Blazor\Syncfusion.DotNet.CLI.Blazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Syncfusion.DotNet.CLI.WPF\Syncfusion.DotNet.CLI.WPF.csproj" />
    <ProjectReference Include="..\Syncfusion.DotNet.CLI.WinForms\Syncfusion.DotNet.CLI.WinForms.csproj" />
    <ProjectReference Include="..\Syncfusion.DotNet.CLI.WinUI\Syncfusion.DotNet.CLI.WinUI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Syncfusion.DotNet.CLI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Syncfusion.DotNet.CLI.nuspec" />
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md" Pack="true" PackagePath="\" />
    <None Update="LICENSE.txt" Pack="true" PackagePath="\" />
    <None Update="syncfusion_logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
